{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "description": "__MSG_appDesc__",
  "version": "0.0.0",
  "default_locale": "zh_CN",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "permissions": ["storage", "offscreen", "tabs", "alarms", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "*://*.youtube.com/*", "*://*.bilibili.com/*", "*://*.tiktok.com/*", "*://*.netflix.com/*"],
  "optional_host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.bilibili.com/*", "*://*.tiktok.com/*", "*://*.netflix.com/*"],
      "js": ["content-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*", "*://*.bilibili.com/*", "*://*.tiktok.com/*", "*://*.netflix.com/*"],
      "js": ["content-isolated.js"],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "__MSG_appName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}

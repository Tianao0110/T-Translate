{
  "name": "t-translate",
  "private": true,
  "version": "0.3.8",
  "description": "Professional offline translation tool with AI support",
  "main": "electron/main.js",
  "scripts": {
    "start": "node scripts/build-stack.js && concurrently --kill-others --kill-others-on-fail \"npm run react:start\" \"node scripts/wait-for-vite.js http://localhost:5173 && npm run electron:start\"",
    "start:debug": "set TT_SELECTION_DEBUG=1&& npm start",
    "react:start": "vite",
    "electron:start": "electron .",
    "stack:build": "node scripts/build-stack.js",
    "build": "node scripts/fetch-ocr-models.js && node scripts/build-stack.js && vite build && electron-builder",
    "dist": "node scripts/fetch-ocr-models.js && node scripts/build-stack.js && vite build && electron-builder --publish=never",
    "ocr:models": "node scripts/fetch-ocr-models.js",
    "ocr:release": "node scripts/build-ocr-release.js",
    "audio:release": "node scripts/build-audio-release.js",
    "smoke:listen": "electron scripts/smoke-listen.js",
    "lint": "eslint src/ electron/",
    "lint:fix": "eslint src/ electron/ --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"electron/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"electron/**/*.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:constants": "node scripts/check-constants.js",
    "check:i18n": "node scripts/check-i18n.js",
    "check:hardcoded": "node scripts/check-hardcoded-chinese.js",
    "check:languages": "node scripts/check-languages.js",
    "check:i18n:strict": "node scripts/check-i18n.js --strict",
    "check:all": "npm run check:constants && npm run check:languages && npm run check:i18n && npm run check:hardcoded"
  },
  "keywords": [
    "translation",
    "ai",
    "offline",
    "electron",
    "react"
  ],
  "author": "Edan Zeng (https://github.com/Tianao0110)",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^8.2.2",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "esbuild": "0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.3.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "vite": "^7.3.5",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "dayjs": "^1.11.19",
    "electron-log": "^5.4.4",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "esearch-ocr": "^8.5.0",
    "i18next": "^23.7.16",
    "immer": "^11.1.0",
    "jszip": "^3.10.1",
    "koffi": "^2.15.0",
    "lucide-react": "^0.303.0",
    "mammoth": "^1.8.0",
    "node-screenshots": "^0.2.1",
    "onnxruntime-node": "^1.26.0",
    "pdfjs-dist": "^4.0.379",
    "react": "^18.2.0",
    "sherpa-onnx-node": "^1.13.6",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.1",
    "uiohook-napi": "^1.5.4",
    "uuid": "^13.0.0",
    "zustand": "^4.4.7"
  },
  "build": {
    "appId": "com.ttranslate.core",
    "productName": "T-Translate",
    "publish": {
      "provider": "github",
      "owner": "Tianao0110",
      "repo": "T-Translate"
    },
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/@napi-rs/**",
      "node_modules/koffi/**",
      "node_modules/uiohook-napi/**",
      "node_modules/node-screenshots/**",
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-win-x64/**"
    ],
    "files": [
      "electron/**/*",
      "build/**/*",
      "!**/*.map",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}",
      "!**/node_modules/**/LICENSE*",
      "!**/node_modules/**/LICENCE*",
      "!**/node_modules/**/*.md",
      "!**/node_modules/**/docs/**",
      "!**/node_modules/**/doc/**"
    ],
    "extraResources": [
      {
        "from": "resources/ocr",
        "to": "resources/ocr",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public/icon.png",
        "to": "resources/icon.png"
      },
      {
        "from": "public/tray-icon.ico",
        "to": "resources/tray-icon.ico"
      },
      {
        "from": "public/screenshot.html",
        "to": "resources/screenshot.html"
      },
      {
        "from": "public/child-pane.html",
        "to": "resources/child-pane.html"
      }
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "installerSidebar": "installer/installerSidebar.bmp",
      "installerHeader": "installer/installerHeader.bmp",
      "include": "installer/installer.nsh",
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ],
      "multiLanguageInstaller": true,
      "differentialPackage": true
    }
  }
}
